{
  "name": "@wc-toolkit/angular-wrappers",
  "version": "0.1.0",
  "description": "Angular wrapper generator for web components using the Custom Elements Manifest (CEM).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "/dist"
  ],
  "scripts": {
    "changeset": "changeset add",
    "build": "tsup src/index.ts --dts --format cjs,esm",
    "analyze": "cem analyze --globs \"demo/app/src/elements/**/*.js\" --outdir demo",
    "demo": "pnpm run build && pnpm run analyze && node demo/generator/generate-wrappers.mjs && echo \"Wrappers written to demo/app/src/app/wrappers\"",
    "demo:app": "pnpm run demo && cd demo/app && npx ng serve",
    "clean": "git clean -fdX",
    "deploy": "npm run build && npm publish",
    "format": "prettier . --write",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "vitest --run --passWithNoTests",
    "prepare": "husky",
    "release": "pnpm run build && changeset publish --access=public"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wc-toolkit/angular-wrappers.git"
  },
  "bugs": {
    "url": "https://github.com/wc-toolkit/angular-wrappers/issues"
  },
  "homepage": "https://wc-toolkit.com/documentation/angular-wrappers",
  "devDependencies": {
    "@angular/core": "^19.2.0",
    "@changesets/cli": "^2.27.12",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.15.21",
    "custom-elements-manifest": "2.1.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "3.4.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@prettier/sync": "^0.6.1",
    "@wc-toolkit/cem-generator": "^0.1.1",
    "@wc-toolkit/cem-utilities": "^1.5.5"
  },
  "peerDependencies": {
    "@angular/core": ">=16.1.0"
  },
  "keywords": [
    "custom-elements",
    "custom-elements-manifest",
    "cem",
    "web-components",
    "components",
    "angular",
    "angular-wrappers",
    "@wc-toolkit/angular-wrappers"
  ],
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.--write": "prettier --write"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "customElements": "demo/custom-elements.json"
}
